{"nodes": [{"id": "docs_01_typescript_readme_branded_type", "label": "Branded ProductId type", "file_type": "rationale", "source_file": "docs/01-typescript/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TypeScript is structural, so two same-shaped string ids are interchangeable; an intersection with a phantom __brand property fakes nominal typing so getProduct(userId) stops compiling."}, {"id": "docs_01_typescript_readme_unknown_vs_any", "label": "unknown vs any vs never", "file_type": "concept", "source_file": "docs/01-typescript/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "any switches the checker off and is contagious; unknown forces narrowing (as attempt() does with e instanceof Error); never is the bottom type used for exhaustiveness via assertNever."}, {"id": "docs_01_typescript_readme_remotedata", "label": "RemoteData discriminated union", "file_type": "rationale", "source_file": "docs/01-typescript/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four booleans allow 16 states, 12 of which are nonsense; a discriminated union makes 'loading with data present' unrepresentable."}, {"id": "docs_01_typescript_readme_distributivity", "label": "Conditional type distributivity", "file_type": "concept", "source_file": "docs/01-typescript/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "T extends U ? X : Y distributes over a naked union parameter; wrapping in a tuple switches it off."}, {"id": "docs_01_typescript_readme_satisfies", "label": "satisfies operator", "file_type": "concept", "source_file": "docs/01-typescript/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "as lies to the compiler and a type annotation widens; satisfies checks without widening, so config.port stays number."}, {"id": "docs_01_typescript_readme_tsconfig_flags", "label": "Strict tsconfig flags beyond strict", "file_type": "concept", "source_file": "docs/01-typescript/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_01_typescript_readme_branded_type", "target": "docs_01_typescript_readme_unknown_vs_any", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/01-typescript/README.md", "source_location": null, "weight": 1.0}, {"source": "docs_01_typescript_readme_remotedata", "target": "docs_01_typescript_readme_unknown_vs_any", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/01-typescript/README.md", "source_location": null, "weight": 1.0}, {"source": "docs_01_typescript_readme_remotedata", "target": "docs_01_typescript_readme_distributivity", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/01-typescript/README.md", "source_location": null, "weight": 1.0}, {"source": "docs_01_typescript_readme_tsconfig_flags", "target": "docs_01_typescript_readme_unknown_vs_any", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/01-typescript/README.md", "source_location": null, "weight": 1.0}, {"source": "docs_01_typescript_readme_remotedata", "target": "readme_demo_typeahead", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/01-typescript/README.md", "source_location": null, "weight": 1.0}, {"source": "docs_01_typescript_readme_satisfies", "target": "readme_packages_core", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/01-typescript/READM