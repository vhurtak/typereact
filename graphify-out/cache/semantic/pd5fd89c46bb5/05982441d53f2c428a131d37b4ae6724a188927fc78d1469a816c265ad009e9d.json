board", "target": "docs_05_system_design_readme_realtime_transport", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/05-system-design/README.md", "source_location": null, "weight": 1.0}, {"source": "docs_05_system_design_readme_problem_collab_editor", "target": "docs_05_system_design_readme_realtime_transport", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/05-system-design/README.md", "source_location": null, "weight": 1.0}, {"source": "docs_05_system_design_readme_problem_collab_editor", "target": "readme_demo_store_undo_redo", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/05-system-design/README.md", "source_location": null, "weight": 1.0}, {"source": "docs_05_system_design_readme_caching_layers", "target": "readme_packages_core", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/05-system-design/README.md", "source_location": null, "weight": 1.0}, {"source": "docs_05_system_design_readme_resilience", "target": "readme_packages_core", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/05-system-design/README.md", "source_location": null, "weight": 1.0}, {"source": "docs_05_system_design_readme_problem_live_dashboard", "target": "docs_02_react_readme_perf_checklist", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/05-system-design/README.md", "source_location": null, "weight": 1.0}, {"source": "docs_05_system_design_readme_problem_design_system", "target": "docs_03_angular_react_vs_angular_translation_table", "relation": "conceptually_related_to", "confidence": "AMBIGUOUS", "confidence_score": 0.3, "source_file": "docs/05-system-design/README.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "layered_caching_across_stack"