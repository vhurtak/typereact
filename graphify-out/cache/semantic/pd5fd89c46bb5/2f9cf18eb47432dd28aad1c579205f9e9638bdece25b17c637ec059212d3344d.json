{"nodes": [{"id": "docs_03_angular_react_vs_angular_translation_table", "label": "React 19 to Angular 20 translation table", "file_type": "document", "source_file": "docs/03-angular/react-vs-angular.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_03_angular_react_vs_angular_reactivity_models", "label": "Re-render diffing vs signal dependency graph", "file_type": "rationale", "source_file": "docs/03-angular/react-vs-angular.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React's granularity is the component and identity is manual (key, memo, dep arrays); Angular's granularity is the expression and the graph handles identity but is easier to wire so nothing updates. The two are converging via the React Compiler and standalone/inject()."}, {"id": "docs_03_angular_react_vs_angular_zoneless", "label": "Zoneless change detection", "file_type": "rationale", "source_file": "docs/03-angular/react-vs-angular.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zone.js monkey-patched every async browser API and checked the whole tree, which is why Angular felt magic and was slow by default. Zoneless checks a view only on signal change, input change, template event, markForCheck, or async pipe emission; it is essentially OnPush everywhere, enforced."}, {"id": "docs_03_angular_react_vs_angular_rxjs_flattening", "label": "RxJS flattening operators", "file_type": "concept", "source_file": "docs/03-angular/react-vs-angular.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Signals have no concept of time, so event streams still want RxJS. switchMap cancels (the typeahead default), mergeMap parallelises, concatMap preserves order, exhaustMap guards double-submit."}, {"id": "docs_03_angular_react_vs_angular_hierarchical_di", "label": "Angular hierarchical DI vs React context", "file_type": "concept", "source_file": "docs/03-angular/react-vs-angular.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The injector walks root to route to element, giving route-scoped lifetimes, InjectionToken, multi providers and @Self/@SkipSelf control that React context cannot do as cleanly. Nest shares the decorator syntax but is module-scoped and needs exports."}, {"id": "docs_03_angular_react_vs_angular_reactive_forms", "label": "Reactive forms and ControlValueAccessor", "file_type": "concept", "source_file": "docs/03-angular/react-vs-angular.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reactive forms are the senior answer because validation is explicit, testable and composable; template-driven ngModel is fine for two fields and hard to test."}], "edges": [{"source": "docs_03_angular_react_vs_angular_translation_table", "target": "docs_03_angular_react_vs_angular_reactivity_models", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/03-angular/react-vs-angular.md", "source_location": null, "weight": 1.0}, {"source": "docs_03_angular_react_vs_angular_translation_table", "target": "readme_apps_react_lab", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/03-angular/react-vs-angular.md", "source_location": null, "weight": 1.0}, {"source": "docs_03_angular_react_vs_angular_translation_table", "target": "readme_apps_angular_lab", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/03-angular/react-vs-angular.md", "source_location": null, "weight": 1.0}, {"source": "docs_03_angular_react_vs_angular_zoneless", "target": "readme_apps_angular_lab", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/03-angular/react-vs-angular.md", "source_location": null, "weight": 1.0}, {"source": "docs_03_angular_react_vs_angular_zoneless", "target": "docs_03_angular_react_vs_angular_reactivity_models", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/03-angular/react-vs-angular.md", "source_location": null, "weight": 1.0}, {"source": "docs_03_angular_react_vs_angular_rxjs_flattening", "target": "readme_demo_typeahead", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/03-angular/react-vs-angular.md", "source_location": null, "weight": 1.0}, {"source": "docs_03_angular_react_vs_angular_rxjs_flattening", "target": "docs_06_live_coding_readme_race_condition", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/03-angular/react-vs-angular.md", "source_location": null, "weight": 1.0}, {"source": "docs_03_angular_react_vs_angular_hierarchical_di", "target": "docs_04_node_readme_nest_request_lifecycle", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/03-angular/react-vs-angular.md", "source_location": null, "weight": 1.0}, {"source": "docs_03_angular_react_vs_angular_reactivity_models", "target": "docs_02_react_readme_memoisation_policy", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/03-angular/react-vs-angular.md", "source_location": null, "weight": 1.0}, {"source": "docs_03_angular_react_vs_angular_reactive_forms", "target": "docs_05_system_design_readme_problem_checkout", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/03-angular/react-vs-angular.md", "source_location": null, "weight": 1.0}], "hyperedges": []}